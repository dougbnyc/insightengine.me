---
import "../styles/site.css";

const { title = "Insight Engine" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <a class="brand" href="/">
          <img src="/logo.png" alt="Insight Engine Logo" />
          <div class="name">Insight Engine</div>
        </a>

        <nav class="nav">
          <a href="/">Home</a>
          <a href="/articles/">Articles</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
