---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("articles");
articles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = (d) => d.toISOString().slice(0, 10);
---

<Layout title="Articles | Insight Engine">
  <section class="card" style="margin-bottom: 18px;">
    <h1 class="h1" style="margin-bottom: 6px;">Articles</h1>
    <div class="meta">Newest first</div>
  </section>

  <section class="card">
    <ul class="list">
      {articles.map((entry) => (
        <li>
          <a href={`/articles/${entry.slug}/`}>{entry.data.title}</a>
          <span class="meta"> — {fmt(entry.data.date)}</span>
        </li>
      ))}
    </ul>
  </section>
</Layout>
