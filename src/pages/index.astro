---
import Layout from "../layouts/layout.astro";
import { getCollection } from "astro:content";

const title = "Articles";

// Load and sort newest-first
const all = await getCollection("articles");
const publishable = all
  .filter((a) => a.data.status !== "Draft")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Language ordering + labels
const LANG_ORDER = ["en", "es", "pt-br"];
const LANG_LABELS: Record<string, string> = {
  en: "English",
  es: "Español",
  "pt-br": "Português (Brasil)",
};

// Group by language
const byLang = publishable.reduce((acc, entry) => {
  const lang = entry.data.language ?? "en";
  (acc[lang] ??= []).push(entry);
  return acc;
}, {} as Record<string, typeof publishable>);

// Stable language list for rendering
const langs = [
  ...LANG_ORDER.filter((l) => byLang[l]?.length),
  ...Object.keys(byLang)
    .filter((l) => !LANG_ORDER.includes(l))
    .sort(),
];
---

<Layout title={title}>
  <section class="card" style="margin-bottom: 18px;">
    <h1 class="h1" style="margin-bottom: 6px;">{title}</h1>
    <div class="meta">Newest first, grouped by language</div>
  </section>

  {langs.map((lang) => (
    <section class="card" style="margin-bottom: 18px;">
      <div style="display:flex; align-items:baseline; justify-content:space-between; gap:12px;">
        <h2 style="margin: 0;">{LANG_LABELS[lang] ?? lang}</h2>
        <div class="meta">{byLang[lang].length} article(s)</div>
      </div>

      <ul class="list" style="margin-top: 10px;">
        {byLang[lang].map((article) => (
          <li>
            <a href={`/articles/${article.slug}/`}>{article.data.title}</a>
            <span class="meta">{" — "}{article.data.date.toLocaleDateString("en-CA")}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>
