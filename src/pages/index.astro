    <p class="tagline">{tagline}</p>

    <div class="nav" style="justify-content: flex-start; flex-wrap: wrap;">
      <a href="https://www.youtube.com/@InsightEngine_Official" target="_blank" rel="noopener noreferrer">YouTube</a>
      <a href="https://www.instagram.com/insightengineofficial/" target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href="https://www.tiktok.com/@insightengineofficial" target="_blank" rel="noopener noreferrer">TikTok</a>
      <a href="https://x.com/InsightEngineMe" target="_blank" rel="noopener noreferrer">X</a>
      <a href="https://www.linkedin.com/company/insightengineofficial/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://www.threads.com/@insightengineofficial?igshid=NTc4MTIwNjQ2YQ==" target="_blank" rel="noopener noreferrer">@Threads</a>
